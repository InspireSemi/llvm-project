				core1a {
					cpu = <&cpu1a>;
				};
				core1b {
					cpu = <&cpu1b>;
				};
				core1c {
					cpu = <&cpu1c>;
				};
				core1d {
					cpu = <&cpu1d>;
				};
				core1e {
					cpu = <&cpu1e>;
				};
				core1f {
					cpu = <&cpu1f>;
				};
			};
		};
	};

	distance-map {
		compatible = "numa-distance-map-v1";
		distance-matrix = <0 0 10>, <0 1 50>, <1 0 50>, <1 1 10>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		dirq0: dirq-interrupt-controller {
			#interrupt-cells = <1>;
			compatible = "inspiresemi,dirq";
			status = "disabled";
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 9>, <&cpu1_intc 9>,
									<&cpu2_intc 9>, <&cpu4_intc 9>,
									<&cpu6_intc 9>;
		};

		usart0: serial@70010100 {
			current-speed = <3000000>;
			clock-names = "usart_clk";
			clocks = <&usart_clk>;
			reg = <0x00 0x70010100 0x00 0x10>;
			reg-shift = <0>;
			status = "disabled";
			compatible = "ns16550a";
			interrupt-parent = <&dirq0>;
			interrupts = <0>;
		};

		usart1: serial@70010000 {
			current-speed = <3000000>;
			clock-names = "usart_clk";
			clocks = <&usart_clk>;
			reg = <0x00 0x70010000 0x00 0x10>;
			reg-shift = <0>;
			status = "disabled";
			compatible = "ns16550a";
			interrupt-parent = <&dirq0>;
			interrupts = <2>;
		};

		usart2: serial@27fe4000000000 {
			current-speed = <3000000>;
			clock-names = "usart_clk";
			clocks = <&usart_clk>;
			reg = <0x0027fe40 0x00 0x00 0x10>;
			reg-shift = <0>;
			status = "disabled";
			compatible = "ns16550a";
			interrupt-parent = <&dirq0>;
			interrupts = <3>;
		};

		usart3: serial@27fe4000000010 {
			current-speed = <3000000>;
			clock-names = "usart_clk";
			clocks = <&usart_clk>;
			reg = <0x0027fe40 0x10 0x00 0x10>;
			reg-shift = <0>;
			status = "disabled";
			compatible = "ns16550a";
			interrupt-parent = <&dirq0>;
			interrupts = <4>;
		};

		eth0: ethernet@808c0000000000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "cdns,gem", "cdns,macb";
			status = "disabled";
			reg = <0x00808c00 0x00000000 0x00 0x1000>;
			interrupt-parent = <&dirq0>;
			interrupts = <1>;
			clocks = <&clk_bus>, <&clk_bus>;
			clock-names = "hclk", "pclk";
			/* Filled in by boot */
			mac-address = [ 52 54 00 12 35 02 ];
			numa-node-id = <0>;
			phy-mode = "gmii";
			ethphy0: ethernet-phy@0 {
				reg = <0>;
			};
		};
	};

	clocks {
		usart_clk: usart_clk {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
			clock-accuracy = <1>;
		};
		clk_bus: clk_bus {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <198000000>;
			clock-accuracy = <1>;
		};
	};
};
