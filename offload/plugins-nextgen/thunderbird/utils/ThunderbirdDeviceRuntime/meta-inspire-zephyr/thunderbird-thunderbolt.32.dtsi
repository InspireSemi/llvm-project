/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "inspire,thunderbird-fpga", "inspire,thunderbird";
	model = "Inspire Semiconductor Thunderbird FPGA";

	aliases {
		serial0 = &usart0;
	};

 	chosen {
		bootargs = "debug console=ttyS0,3000000 earlycon=uart,mmio,0x70010100 rodata=off no5lvl root=ram";
		linux,initrd-start = <0x1100 0x08200000>;
		linux,initrd-end = <0x1100 0x132b35b6>;
		rng-seed = <0x4fe9397d 0xb7883060 0xe56ff3c2 0xb05b4e3 0x62e5479c 0xd932a9c8 0x95a47b5b 0x192ef245>;
		stdout-path = "serial0";
	};

	sram0: memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x00000000 0x00000000 0x02000000>;
		numa-node-id = <1>;
	};

	sram2: memory@4000000 {
		device_type = "memory";
		reg = <0x00000000 0x04000000 0x00000000 0x02000000>;
		numa-node-id = <1>;
	};

	sram4: memory@8000000 {
		device_type = "memory";
		reg = <0x00000000 0x08000000 0x00000000 0x02000000>;
		numa-node-id = <1>;
	};

	ddrwt: memory@110000000000 {
		device_type = "memory";
		reg = <0x00001100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	ddrwm: memory@10110000000000 {
		device_type = "memory";
		reg = <0x00101100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	ddrwb: memory@20110000000000 {
		device_type = "memory";
		reg = <0x00201100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	ddret: memory@3910000000000 {
		device_type = "memory";
		reg = <0x00039100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	ddrem: memory@13910000000000 {
		device_type = "memory";
		reg = <0x00139100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	ddreb: memory@23910000000000 {
		device_type = "memory";
		reg = <0x00239100 0x00000000 0x00000001 0x00000000>;
		numa-node-id = <0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ivshmem_shm: shm@8200000000000000 {
			compatible = "inspire,ivshmem-shm";
			reg = <0x00820000 0x00000000 0x00000000 0x00400000>;
			/* Optional heap offset for Zephyr to start k_heap */
			inspire,heap-offset = <0x00010000>;
			no-map;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <500000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			reg-names = "cpuid", "sram", "corereg";
			reg = <0x0000 0x00000000 0x20000000>;
			status = "disabled";
			compatible = "inspiresemi,riscv-2464", "riscv";
			riscv,isa = "rv64imafdc";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei" ;
			mmu-type = "riscv,sv48";
			numa-node-id = <1>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			cpu0_intc: interrupt-controller {
				#interrupt-cells = <0x01>;
				interrupt-controller;
				status = "disabled";
				compatible = "riscv,cpu-intc";
			};
			clint0: clint@20004000 {
				interrupts-extended = <&cpu0_intc 0x03 &cpu0_intc 0x07>;
				reg-names = "irqs", "mtime", "mtimecmp";
				reg = <0x00 0x20004000 0x00 0x8 0x00 0x2000fff8 0x00 0x8 0x00 0x20008000 0x00 0x8>;
				status = "disabled";
				compatible = "riscv,aclint-mswi", "riscv,aclint-mtimer";
			};
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			reg-names = "cpuid", "sram", "corereg";
			reg = <0x0001 0x00010000 0x20010000>;
			status = "disabled";
			compatible = "inspiresemi,riscv-2464", "riscv";
			riscv,isa = "rv64imafdc";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei" ;
			mmu-type = "riscv,sv48";
			numa-node-id = <1>;
